# Secrets: model API keys. Never committed; .env.example is the template.
.env

# Made on each machine; sim/setup.sh recreates all of them (sim/README.md, Quick start).
# data/: Habitat's data, the downloaded models, the built scenes, the placeholder scenes.
# runs/: what each run and each request leaves behind. .cache/: the pipeline's cache of model answers.
data/
runs/
.cache/
.venv/

# Unpacked from the run-log release (results/README.md).
/results/data/

# Python's own leftovers
__pycache__/
*.egg-info/
.pytest_cache/

# A local folder of service settings and keys. Never committed.
soclaas/
